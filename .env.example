# ============================================
# MAXLITH MANAGEMENT — Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maxlith_management?schema=public"

# NextAuth
AUTH_SECRET="your-auth-secret-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth (optional)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Email (optional - Phase 6)
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@maxlith.com"

# AI (optional - Phase 7)
# GEMINI_API_KEY=""

# File Storage (optional - Phase 3)
# STORAGE_PROVIDER="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="MAXLITH Management"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
